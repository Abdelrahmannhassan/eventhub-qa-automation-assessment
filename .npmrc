# Reproducible installs.
#
# save-exact: new dependencies are pinned to an exact version instead of a `^`
# range, so a fresh `npm install` can never silently pull a different minor.
# Combined with the committed package-lock.json and `npm ci` in CI, the
# dependency tree is identical on every machine and in every pipeline run.
save-exact=true

# Keep install output quiet and deterministic in CI logs.
fund=false
audit=false
