{
  "name": "eventhub-qa-automation-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Unified UI + API test automation framework for EventHub (Playwright + TypeScript).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:e2e": "playwright test --project=e2e-chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:unit": "playwright test --project=unit",
    "test:contract": "playwright test --grep @contract",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --output ./allure-report --clean",
    "allure:single": "allure awesome ./allure-results --output ./allure-report --single-file",
    "allure:open": "allure open ./allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check",
    "clean": "rm -rf test-results playwright-report allure-results allure-report .auth"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "allure": "3.22.1",
    "allure-playwright": "3.14.0",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "zod": "4.6.7"
  }
}
