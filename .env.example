# ---------------------------------------------------------------------------
# EventHub QA Automation — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored. NEVER commit real credentials.
# In CI these are supplied as GitHub Actions secrets / variables (see README).
# ---------------------------------------------------------------------------

# Which target environment to run against. Resolves base URLs in src/config/env.ts
TEST_ENV=production

# Application under test. Overrides the TEST_ENV defaults when set.
BASE_URL=https://eventhub.rahulshettyacademy.com
API_BASE_URL=https://api.eventhub.rahulshettyacademy.com

# ---------------------------------------------------------------------------
# Test accounts.
#
# Confirmed in Phase 2 (docs/api-findings.md): auth is a 7-day JWT bearer token
# from POST /auth/register or /auth/login, and registration requires NO email
# verification — so accounts are disposable and can be created on demand.
#
# Use DEDICATED THROWAWAY accounts with unique, randomly generated passwords and
# no real personal data. Test artifacts (traces, videos, CI uploads) can expose a
# session token, and this repository is public — see ADR 0007.
#
# Account A — primary: books tickets, exercises the full happy path.
# Account B — secondary: proves cross-account isolation (B must not read or
#             cancel A's bookings; the API enforces this with 403/404).
# ---------------------------------------------------------------------------
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
